#!/bin/bash
# Install artmrn.pip-video: symlinks the helpers into ~/.local/bin and sources
# the Hyprland snippets from your config with your explicit consent.
#
# Idempotent: rerunning skips what is already installed. Backs configs up
# before touching them and rolls back if Hyprland reports config errors.

set -euo pipefail

PLUGIN_ID="artmrn.pip-video"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HYPR_DIR="$HOME/.config/hypr"
BIN_DIR="$HOME/.local/bin"
BEGIN="-- BEGIN $PLUGIN_ID"
END="-- END $PLUGIN_ID"
ASSUME_YES=0
[[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && ASSUME_YES=1

fail() { echo "install: $*" >&2; exit 1; }

if (( ! ASSUME_YES )); then
  if [[ -t 0 && -t 1 ]] && command -v gum >/dev/null 2>&1; then
    gum confirm "Install $PLUGIN_ID? Appends managed blocks to ~/.config/hypr/hyprland.lua and bindings.lua (backed up first) and symlinks 3 helpers into ~/.local/bin." || exit 1
  else
    fail "pass --yes to install non-interactively"
  fi
fi

# Back up this invocation, rather than reusing a .bak from an older install.
# Keep the snapshot after success too, so replaced helpers remain recoverable.
for file in "$HYPR_DIR/hyprland.lua" "$HYPR_DIR/bindings.lua"; do
  [[ -f $file ]] || fail "$file not found"
done
for name in video-wallpaper workspace-opacity omarchy-pip-video; do
  [[ -x "$SCRIPT_DIR/bin/$name" ]] || fail "helper $name not found"
  [[ ! -d "$BIN_DIR/$name" ]] || fail "$BIN_DIR/$name is a directory"
done
BACKUP_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/$PLUGIN_ID"
mkdir -p "$BACKUP_ROOT" "$BIN_DIR"
BACKUP=$(mktemp -d "$BACKUP_ROOT/install.XXXXXXXX")
mkdir "$BACKUP/config" "$BACKUP/bin"
for name in hyprland.lua bindings.lua; do
  cp -pL -- "$HYPR_DIR/$name" "$BACKUP/config/$name"
done
for name in video-wallpaper workspace-opacity omarchy-pip-video; do
  dest="$BIN_DIR/$name"
  if [[ -e $dest || -L $dest ]]; then
    cp -a -- "$dest" "$BACKUP/bin/$name"
  fi
done

committed=0
rollback() {
  local result=$? name
  trap - EXIT
  if (( ! committed )); then
    echo "Restoring this install's snapshot: $BACKUP" >&2
    for name in hyprland.lua bindings.lua; do
      # Copy through any config symlink, preserving the user's layout.
      cp -p -- "$BACKUP/config/$name" "$HYPR_DIR/$name" || result=1
    done
    for name in video-wallpaper workspace-opacity omarchy-pip-video; do
      rm -f -- "$BIN_DIR/$name" || result=1
      if [[ -e "$BACKUP/bin/$name" || -L "$BACKUP/bin/$name" ]]; then
        cp -a -- "$BACKUP/bin/$name" "$BIN_DIR/$name" || result=1
      fi
    done
    hyprctl reload >/dev/null 2>&1 || echo "Original files restored; Hyprland reload failed." >&2
    result=1
  fi
  exit "$result"
}
trap rollback EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

link_bin() {
  local source="$SCRIPT_DIR/bin/$1" dest="$BIN_DIR/$1"
  mkdir -p "$BIN_DIR" || fail "cannot create $BIN_DIR"
  if [[ -L $dest ]]; then
    [[ "$(readlink -f "$dest")" == "$(readlink -f "$source")" ]] && { echo "linked: $dest"; return 0; }
    rm -f "$dest"
  elif [[ -e $dest ]]; then
    rm -f -- "$dest"
    echo "backed up: $BACKUP/bin/$1"
  fi
  ln -s "$source" "$dest" || fail "could not link $dest"
  echo "linked: $dest"
}

add_block() {
  local file="$1" snippet="$2"
  [[ -f $file ]] || fail "$file not found"
  if grep -qF -- "$BEGIN" "$file"; then
    echo "present: $file block"
    return 0
  fi
  local quoted
  quoted=$(jq -Rn --arg path "$snippet" '$path')
  {
    printf '\n%s\n' "$BEGIN"
    printf 'dofile(%s)\n' "$quoted"
    printf '%s\n' "$END"
  } >> "$file"
  echo "added: $file block"
}

link_bin video-wallpaper
link_bin workspace-opacity
link_bin omarchy-pip-video
add_block "$HYPR_DIR/hyprland.lua" "$SCRIPT_DIR/hypr/pip-video.lua"
add_block "$HYPR_DIR/bindings.lua" "$SCRIPT_DIR/hypr/pip-video-bindings.lua"

hyprctl reload >/dev/null 2>&1 || fail "could not reload Hyprland"
sleep 1
errors=$(hyprctl configerrors 2>/dev/null) || fail "could not check Hyprland config"
if [[ -n "$errors" ]]; then
  echo "Hyprland reported errors, rolling back:" >&2
  printf '%s\n' "$errors" >&2
  fail "invalid config"
fi
committed=1

cat <<NOTE
Installed $PLUGIN_ID.
Backup: $BACKUP
Next: enable the plugin in the shell, then install mpvpaper for video
wallpapers: omarchy pkg aur add mpvpaper
Checkup anytime: omarchy-pip-video doctor
NOTE
