#!/bin/bash
# omarchy:summary=Play a video (or YouTube URL) as the wallpaper via mpvpaper.
set -euo pipefail

umask 077

fail() { echo "video-wallpaper: $*" >&2; exit 1; }

private_directory() {
  [[ -d "$1" && ! -L "$1" && -O "$1" && "$(stat -c '%a' -- "$1")" == 700 ]] ||
    fail "runtime directory must be owned by this user, mode 0700, and not a symlink"
}

RUNTIME=${XDG_RUNTIME_DIR:-}
[[ "$RUNTIME" == /* && "$RUNTIME" != *[[:space:]]* ]] || fail "a private XDG_RUNTIME_DIR is required"
RUNTIME=${RUNTIME%/}
private_directory "$RUNTIME"
[[ "$(realpath -e -- "$RUNTIME")" == "$RUNTIME" ]] || fail "runtime path must not contain symlinks"
RUNTIME="$RUNTIME/artmrn.pip-video"
if [[ ! -e "$RUNTIME" && ! -L "$RUNTIME" ]]; then
  mkdir -m 700 -- "$RUNTIME" || fail "cannot create private runtime directory"
fi
private_directory "$RUNTIME"
SOCKET="$RUNTIME/mpvpaper.sock"

verify_socket() {
  private_directory "$RUNTIME"
  [[ ! -L "$SOCKET" ]] || fail "refusing symlink at control socket"
  if [[ -e "$SOCKET" ]]; then
    [[ -S "$SOCKET" && -O "$SOCKET" ]] || fail "refusing unsafe control socket"
  fi
}
verify_socket
STATE_FILE="$HOME/.cache/video-wallpaper/last"
SETTINGS_FILE="$HOME/.config/artmrn.pip-video/settings.conf"

usage() {
  echo "Usage: video-wallpaper {set <url|path>|clip|stop|pause|mute|status}"
}

notify() { omarchy-notification-send -u low "$1" >/dev/null 2>&1 || true; }

running() { pgrep -u "$EUID" -x mpvpaper >/dev/null 2>&1; }

ipc() { verify_socket; [ -S "$SOCKET" ] && printf '%s\n' "$1" | socat - "$SOCKET" >/dev/null 2>&1; }

resolve_media() {
  local media=$1
  if [[ "$media" =~ ^https?:// ]]; then
    printf '%s' "$media"
  elif [[ -f "$media" ]]; then
    realpath -- "$media"
  else
    return 1
  fi
}

stop_all() {
  # mpvpaper sometimes ignores SIGTERM, so escalate: TERM, brief wait, KILL.
  verify_socket
  pkill -u "$EUID" -x mpvpaper 2>/dev/null || true
  local i
  for i in $(seq 1 10); do
    running || break
    sleep 0.2
  done
  pkill -9 -u "$EUID" -x mpvpaper 2>/dev/null || true
  verify_socket
  if [[ -S "$SOCKET" ]]; then rm -- "$SOCKET"; fi
}

start() {
  local media
  media=$(resolve_media "$1") || { notify "Video wallpaper: not a URL or existing file"; exit 1; }
  command -v mpvpaper >/dev/null 2>&1 || { notify "Video wallpaper: install mpvpaper first (omarchy pkg aur add mpvpaper)"; exit 1; }
  stop_all
  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s' "$media" > "$STATE_FILE"
  local mpv_opts="loop-playlist input-ipc-server=$SOCKET"
  if [[ "$(grep -E '^start_muted=' "$SETTINGS_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)" == "1" ]]; then
    mpv_opts="$mpv_opts mute=yes"
  fi
  if mpvpaper -pf -o "$mpv_opts" ALL "$media" >/dev/null 2>&1; then
    notify "Video wallpaper on"
  else
    notify "Video wallpaper: mpvpaper failed to start"
    exit 1
  fi
}

case "${1:-}" in
  set)
    [[ $# -ge 2 ]] || { usage >&2; exit 1; }
    start "$2"
    ;;
  clip)
    media=$(wl-paste --no-newline 2>/dev/null | head -n1)
    [[ -n "$media" ]] || { notify "Video wallpaper: clipboard is empty"; exit 1; }
    start "$media"
    ;;
  stop)
    stop_all
    notify "Video wallpaper off"
    ;;
  pause)
    ipc "cycle pause" && notify "Video wallpaper: paused/resumed" || notify "Video wallpaper: not running"
    ;;
  mute)
    ipc "cycle mute" && notify "Video wallpaper: muted/unmuted" || notify "Video wallpaper: not running"
    ;;
  status)
    if running; then
      echo "running: $(cat "$STATE_FILE" 2>/dev/null || echo unknown)"
    else
      echo "stopped"
    fi
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
