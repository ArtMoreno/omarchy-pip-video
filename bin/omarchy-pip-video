#!/bin/bash
# omarchy:summary=PiP Video control and self-check (doctor/status).
set -uo pipefail

PLUGIN_ID="artmrn.pip-video"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$HOME/.local/bin"
HYPR_DIR="$HOME/.config/hypr"
SETTINGS_FILE="$HOME/.config/artmrn.pip-video/settings.conf"

usage() {
  cat <<USAGE
Usage: omarchy-pip-video {doctor [--on-load]|status|set KEY VALUE|get KEY|howto}

  doctor            Check helpers, config blocks, dependencies, Hyprland errors
  doctor --on-load  Same, but quiet when healthy (used by Service.qml)
  status            One-line state: video wallpaper + workspace opacity
  set KEY VALUE     Change a setting (opacity_step 0.05-0.25, start_muted 0/1)
  get KEY           Print a setting value
  settings          Print all settings as KEY=VALUE lines (for the widget)
  howto             Print the quick-start guide
USAGE
}

notify() { omarchy-notification-send -u low "$1" >/dev/null 2>&1 || true; }

problems=()

check_bins() {
  local name
  for name in video-wallpaper workspace-opacity omarchy-pip-video; do
    if [[ -x "$BIN_DIR/$name" ]]; then
      echo "  ok       $BIN_DIR/$name"
    else
      echo "  missing  $BIN_DIR/$name (run ./install)"
      problems+=("helper $name not linked")
    fi
  done
}

check_blocks() {
  local keys_tmp="$1"
  if grep -qF -- "-- BEGIN $PLUGIN_ID" "$HYPR_DIR/hyprland.lua" 2>/dev/null \
  && grep -qF -- "-- BEGIN $PLUGIN_ID" "$HYPR_DIR/bindings.lua" 2>/dev/null; then
    echo "  ok       managed config blocks"
    return 0
  fi
  if grep -qF "YouTube PiP smaller" "$keys_tmp" 2>/dev/null \
  && grep -qF "Video wallpaper from clipboard" "$keys_tmp" 2>/dev/null \
  && grep -qF "Workspace windows more transparent" "$keys_tmp" 2>/dev/null; then
    echo "  ok       binds registered live (inline install)"
    return 0
  fi
  echo "  missing  config blocks and live binds (run ./install)"
  problems+=("hyprland config")
  return 1
}

check_deps() {
  local dep
  for dep in hyprctl jq wl-paste socat yt-dlp; do
    if command -v "$dep" >/dev/null 2>&1; then
      echo "  ok       $dep"
    else
      echo "  missing  $dep"
      problems+=("dependency $dep")
    fi
  done
  if command -v mpvpaper >/dev/null 2>&1; then
    echo "  ok       mpvpaper"
  else
    echo "  missing  mpvpaper (video wallpaper needs: omarchy pkg aur add mpvpaper)"
    problems+=("mpvpaper")
  fi
}

check_hyprland() {
  local errors
  errors=$(hyprctl configerrors 2>/dev/null)
  if [[ -z "$errors" ]]; then
    echo "  ok       hyprctl configerrors clean"
  else
    echo "  errors   hyprctl configerrors:"
    printf '%s\n' "$errors" | sed 's/^/    /'
    problems+=("hyprland config errors")
  fi
}

cmd_doctor() {
  local on_load=0
  [[ "${1:-}" == "--on-load" ]] && on_load=1
  problems=()
  local keys_tmp out_tmp report ret=0
  keys_tmp=$(mktemp)
  out_tmp=$(mktemp)
  omarchy menu keybindings --print >"$keys_tmp" 2>/dev/null || true
  { check_bins; check_blocks "$keys_tmp"; check_deps; check_hyprland; } >"$out_tmp" 2>&1
  report=$(cat "$out_tmp")
  rm -f "$keys_tmp" "$out_tmp"
  if (( ${#problems[@]} == 0 )); then
    (( on_load )) || printf '%s\n' "$report"
    return 0
  fi
  ret=1
  if (( on_load )); then
    notify "PiP Video setup incomplete: ${problems[0]} (run omarchy-pip-video doctor)"
  else
    printf '%s\n' "$report"
    echo "problems: ${problems[*]}"
  fi
  return 1
}

cmd_status() {
  "$BIN_DIR/video-wallpaper" status 2>/dev/null || echo "video wallpaper: helper missing"
  local ws level
  ws=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.id' 2>/dev/null || echo "?")
  level=$(jq -r --arg ws "$ws" '.[$ws] // 1.0' "$HOME/.cache/workspace-opacity.json" 2>/dev/null || echo 1.0)
  echo "workspace $ws opacity: $level"
}

valid_setting() {
  case "$1" in
    opacity_step) awk -v s="$2" 'BEGIN { exit (s >= 0.05 && s <= 0.25) ? 0 : 1 }' 2>/dev/null ;;
    start_muted) [[ "$2" == "0" || "$2" == "1" ]] ;;
    *) return 1 ;;
  esac
}

cmd_set() {
  [[ $# -ge 2 ]] || { echo "usage: omarchy-pip-video set <opacity_step|start_muted> <value>" >&2; return 1; }
  valid_setting "$1" "$2" || { echo "invalid setting: $1=$2" >&2; return 1; }
  mkdir -p "$(dirname "$SETTINGS_FILE")"
  local kept
  kept=$(grep -vE "^$1=" "$SETTINGS_FILE" 2>/dev/null | grep -v '^$' || true)
  if [[ -n "$kept" ]]; then
    printf '%s\n%s=%s\n' "$kept" "$1" "$2" > "$SETTINGS_FILE"
  else
    printf '%s=%s\n' "$1" "$2" > "$SETTINGS_FILE"
  fi
  echo "$1=$2"
}

cmd_get() {
  [[ $# -ge 1 ]] || { usage >&2; return 1; }
  local default
  case "$1" in
    opacity_step) default="0.1" ;;
    start_muted) default="0" ;;
    *) echo "unknown setting: $1" >&2; return 1 ;;
  esac
  local value
  value=$(grep -E "^$1=" "$SETTINGS_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-)
  printf '%s\n' "${value:-$default}"
}

cmd_settings() {
  local key value
  for key in opacity_step start_muted; do
    value=$(cmd_get "$key" 2>/dev/null) || value=""
    printf '%s=%s\n' "$key" "$value"
  done
}

cmd_howto() { cat <<'HOWTO'
PiP Video quick start
  Watch YouTube, pop the video out (PiP), then:
  SUPER+ALT+H / L      PiP smaller / bigger (keeps 16:9)
  SUPER+ALT+J / U      PiP shorter / taller
  SUPER + pinch        grow/shrink the PiP live (hold SUPER first)
  SUPER + right-drag   resize any floating window
Video wallpaper
  Copy a YouTube URL, SUPER+ALT+V plays it behind all windows.
  SUPER+ALT+P pause, SUPER+ALT+B mute, SUPER+ALT+C stop.
See-through workspaces
  SUPER+CTRL+[ / ]     fade this workspace to see the video behind apps.
  SUPER+ALT+BACKSPACE  back to opaque. Each workspace keeps its level.
Settings: omarchy-pip-video set opacity_step 0.15 | set start_muted 1
Checkup: omarchy-pip-video doctor · Full guide in the plugin README.
HOWTO
}

case "${1:-}" in
  doctor) shift; cmd_doctor "$@" ;;
  status) shift; cmd_status "$@" ;;
  set) shift; cmd_set "$@" ;;
  get) shift; cmd_get "$@" ;;
  settings) shift; cmd_settings "$@" ;;
  howto) shift; cmd_howto "$@" ;;
  --help | help | "-h" | "") usage ;;
  *) echo "omarchy-pip-video: unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
